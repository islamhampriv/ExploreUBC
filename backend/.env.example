# Server configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/cpen321

# Ticketmaster event search
TICKETMASTER_API_KEY=your_ticketmaster_api_key
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2
EVENT_SEARCH_CITY=Vancouver
EVENT_SEARCH_STATE_CODE=BC
EVENT_SEARCH_COUNTRY_CODE=CA
EVENT_SEARCH_PAGE_SIZE=200

# Google Auth 
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT 
JWT_SECRET=your_jwt_secret_key_here

# Other API keys, secrets, and configurations
