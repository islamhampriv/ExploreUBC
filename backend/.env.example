# Server configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/cpen321

# Ticketmaster event search
TICKETMASTER_API_KEY=your_ticketmaster_api_key
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2
EVENT_SEARCH_CITY=Vancouver
EVENT_SEARCH_STATE_CODE=BC
EVENT_SEARCH_COUNTRY_CODE=CA
EVENT_SEARCH_PAGE_SIZE=200

# Google Auth 
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Maps Platform
MAPS_API_KEY=your_maps_api_key
GEOCODING_API_KEY=your_geocoding_api_key
ROUTES_API_KEY=your_routes_api_key
PLACES_API_KEY=your_places_api_key

# JWT 
JWT_SECRET=your_jwt_secret_key_here

# SoCLaaS itinerary generation (OpenAI-compatible Responses API)
SOCLAAS_ENDPOINT=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=your_soclaas_api_key
SOCLAAS_MODEL=qwen3.6:35b
SOCLAAS_MAX_OUTPUT_TOKENS=16384

# Other API keys, secrets, and configurations
