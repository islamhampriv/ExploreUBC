@startuml
title Use Case 4: View Event Recommendations
hide footbox
skinparam ParticipantStyle rectangle
skinparam Shadowing false

actor User
participant "FrontEnd" as App
participant "LiveEvents" as Events
participant "Users" as Users
database "MongoDB" as DB

note over App,Events
userId comes from the authenticated session. options comes from the event-list UI.
Later-page options are derived from the previous response's next-page cursor.
Preferences loaded below are reused for pagination.
end note

note over Events, DB
Ticketmaster events were synchronized into MongoDB earlier.
end note

User -> App : Open Live Events
App -> Events : getRecommendedEvents(userId: string, options: EventRecommendationOptions): Promise<RecommendedLiveEvent[]>
alt initial retrieval fails because of network or server error
    Events --> App : retrieval error
    App --> User : Keep existing cards and offer retry
else recommendations retrieved
    Events -> Users : UserRepository.findPreferences(userId: string): Promise<UserPreferences | null>
    Users -> DB : findPreferences(userId: string): Promise<UserPreferences | null>
    DB --> Users : UserPreferences
    Users --> Events : UserPreferences
    Events -> DB : findNearbyUpcomingEvents(query: EventQuery): Promise<LiveEventCandidate[]>
    DB --> Events : LiveEventCandidate[]
    Events -> Events : scoreAndPaginate(candidates: LiveEventCandidate[], preferences: UserPreferences, options: EventRecommendationOptions): RecommendedLiveEvent[]
    Events --> App : RecommendedLiveEvent[]
    alt recommendations found
        App --> User : Display event cards and indicate whether more are available
        User -> App : Review recommended events
        opt user loads more
            User -> App : Load next page
            App -> Events : getRecommendedEvents(userId: string, options: EventRecommendationOptions): Promise<RecommendedLiveEvent[]>
            alt next page fails to load
                Events --> App : retrieval error
                App --> User : Keep existing cards and offer retry
            else next page retrieved
                Events -> DB : findNearbyUpcomingEvents(query: EventQuery): Promise<LiveEventCandidate[]>
                DB --> Events : LiveEventCandidate[]
                Events -> Events : scoreAndPaginate(candidates: LiveEventCandidate[], preferences: UserPreferences from initial retrieval, options: EventRecommendationOptions): RecommendedLiveEvent[]
                Events --> App : RecommendedLiveEvent[]
                App --> User : Append event cards
            end
        end
    else no recommendations
        App --> User : Display no-matching-events message
    end
end
@enduml
