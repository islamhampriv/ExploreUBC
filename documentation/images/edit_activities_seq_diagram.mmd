sequenceDiagram
    actor User
    participant App as FrontEnd
    participant Itineraries
    participant DB as MongoDB

    User->>App: Open saved itinerary
    App->>Itineraries: getItinerary(userId: string from session, itineraryId: string from selected itinerary): Promise<Itinerary>
    Itineraries->>DB: findItinerary(userId: string, itineraryId: string): Promise<Itinerary | null>
    DB-->>Itineraries: Itinerary
    Itineraries-->>App: Itinerary
    App-->>User: Display itinerary
    User->>App: Select activity
    App-->>User: Display activity details
    User->>App: Select Edit
    App-->>User: Display activity editor

    User->>App: Edit name, duration, location, or description
    alt invalid start or end time
        App-->>User: Disable Save and show invalid-time error message
    else valid input
        App-->>User: Enable Save
        User->>App: Select Save
        App->>Itineraries: updateActivity(userId: string from session, itineraryId: string from opened itinerary, activityId: string from selected activity, update: ActivityUpdate from edited fields, replaceConflicts: boolean = false): Promise<ActivityItem>
        Itineraries->>DB: findItinerary(userId: string, itineraryId: string): Promise<Itinerary | null>
        DB-->>Itineraries: Itinerary
        alt schedule conflict
        Itineraries-->>App: ItineraryTimeConflictError(conflicts: ActivityItem[] derived from loaded Itinerary)
            App-->>User: Display conflicting items and offer to keep or replace
            alt keep existing schedule
                User->>App: Keep existing schedule
                App-->>User: Display original activity and end use case
            else replace conflicts
                User->>App: Confirm replacement
                App->>Itineraries: updateActivity(userId: string from session, itineraryId: string from opened itinerary, activityId: string from selected activity, update: ActivityUpdate from edited fields, replaceConflicts: boolean = true): Promise<ActivityItem>
                Itineraries->>DB: replaceEmbeddedItems(userId: string, itineraryId: string, removedItemIds: Itinerary.conflictingItemIds, activity: ActivityItem): Promise<boolean>
                alt replacement is stored
                    DB-->>Itineraries: success
                    Itineraries-->>App: ActivityItem
                    App-->>User: Display updated activity
                else storage or network error
                    DB-->>Itineraries: error
                    Note over Itineraries,DB: Previously stored activity remains unchanged.
                    Itineraries-->>App: update error
                    App-->>User: Show save error and allow retry
                end
            end
        else no conflict
            Itineraries->>DB: updateEmbeddedActivity(userId: string, itineraryId: string, activityId: string, update: ActivityUpdate): Promise<boolean>
            alt update is stored
                DB-->>Itineraries: success
                Itineraries-->>App: ActivityItem
                App-->>User: Display updated activity
            else storage or network error
                DB-->>Itineraries: error
                Note over Itineraries,DB: Previously stored activity remains unchanged.
                Itineraries-->>App: update error
                App-->>User: Show save error and allow retry
            end
        end
    end
